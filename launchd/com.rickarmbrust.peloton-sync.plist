<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rickarmbrust.peloton-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/rick/scripts/peloton-sync.sh</string>
    </array>

    <!-- Fire when a file is added/modified in either watched folder -->
    <key>WatchPaths</key>
    <array>
        <string>/Users/rick/Downloads</string>
        <string>/Users/rick/Library/Mobile Documents/com~apple~CloudDocs/kb/health-data</string>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/rick/Library/Logs/peloton-sync-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/rick/Library/Logs/peloton-sync-stderr.log</string>

    <!-- Do not run immediately on load -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
