# Airtable — add these to ~/.env (loaded by peloton-sync.sh)
AIRTABLE_TOKEN=pat_your_airtable_personal_access_token

# Airtable base and table IDs are hardcoded in peloton-sync.sh
# BASE_ID=appBmQA2p3z2Fdofa
# TABLE_ID=tblBuzhfztfwgE59f

# Note: Peloton credentials are NOT stored here.
# The scraper (scraper/peloton_class_scrape_stateful.py) uses a saved
# browser session in scraper/peloton_state.json (gitignored).
# Run scraper/peloton_login_save_session.py once to generate it.
